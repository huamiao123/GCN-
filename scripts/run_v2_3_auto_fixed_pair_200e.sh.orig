#!/usr/bin/env bash
# Same-node regression pair for the repaired v2_3_auto profile.
# Array 0 = Products, array 1 = IGB-HOM-small (19 classes).  Each array
# element runs TFS and native stock DGL sequentially in one exclusive node so
# the two wall times are paired and no cross-node frequency difference enters
# the comparison.
#SBATCH -p intel_expr
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 32
#SBATCH --mem=480G
#SBATCH --exclusive
#SBATCH --sockets-per-node=1
#SBATCH --cores-per-socket=32
#SBATCH --threads-per-core=1
#SBATCH -t 02:00:00
#SBATCH --array=0-1%1
#SBATCH -J v23_auto_fixed_pair
#SBATCH -o /home/huangjianqiang_group/hdacp1/data/wzh/final_v2_2/slurm/v23_auto_fixed_pair_%A_%a.out
#SBATCH -e /home/huangjianqiang_group/hdacp1/data/wzh/final_v2_2/slurm/v23_auto_fixed_pair_%A_%a.err

set -euo pipefail

# Match the established authority launchers: AMX/oneDNN runtime libraries
# must be loaded before importing the extension.  The previous paired probe
# omitted this, making a startup failure indistinguishable from a kernel
# regression on some nodes.
if ! module load intel/intel-oneapi-compilers/2024.1.0/gcc8.5.0-5ndeojp; then
  echo "required Intel runtime module could not be loaded" >&2
  exit 3
fi

ROOT=${TFS_ROOT:-/home/huangjianqiang_group/hdacp1/data/wzh/final_v2_2}
RUN_ROOT=${V23_FIXED_RUN_ROOT:-$ROOT/runs/v2_3_dataflow_fixed_pair_200e_20260818}
IGB_ROOT_DEFAULT=${IGB_ROOT:-/home/huangjianqiang_group/hdacp1/data/wzh/datasets/igb_homogeneous_small}
PRODUCTS_CACHE_DEFAULT=${PRODUCTS_CACHE:-/home/huangjianqiang_group/hdacp1/data/wzh/datasets/ogbn-products_official/processed_tfs_v1/ogbn_products_canonical_v1.pt}
point=${SLURM_ARRAY_TASK_ID:-0}

case "$point" in
  0)
    dataset=products
    test_py="$ROOT/tests/hybrid_fullstep_products_detailed.py"
    input_dim=100; out_dim=47; hidden_dim=128; layers=2
    run_name=products
    ;;
  1)
    dataset=igb19
    test_py="$ROOT/tests/hybrid_aggregatewide_bf16grad_strongdgl_v3.py"
    input_dim=1024; out_dim=19; hidden_dim=128; layers=2
    run_name=igb19
    ;;
  *) echo "invalid array point: $point" >&2; exit 2 ;;
esac

run_one() {
  local method="$1"
  local tag
  if [[ "$method" == hybrid ]]; then tag=tfs_v2_3_auto_fixed; else tag=dgl_native_stock; fi
  local run="$RUN_ROOT/${run_name}_${tag}"
  mkdir -p "$run"
  test ! -e "$run/status.json" || { echo "run already exists: $run" >&2; return 90; }

  export HYBRID_INPUT_DIM="$input_dim" HYBRID_HIDDEN_DIM="$hidden_dim" HYBRID_OUT_DIM="$out_dim"
  export HYBRID_LAYERS="$layers" HYBRID_SEED=101 HYBRID_TRAIN_EPOCHS=200
  export HYBRID_WARMUPS=0 HYBRID_REPEATS=0 HYBRID_LAYER_PROFILE=0
  export HYBRID_DETAILED_PROFILE=0 HYBRID_DGL_OP_PROFILE=0 HYBRID_DTYPE=fp32
  export HYBRID_GRAD_TOL=0.03 HYBRID_FORWARD_TOL=0.03
  export OMP_NUM_THREADS=32 MKL_NUM_THREADS=32 OMP_DYNAMIC=FALSE MKL_DYNAMIC=FALSE
  export OMP_PROC_BIND=close OMP_PLACES=cores
  export LD_LIBRARY_PATH="/home/huangjianqiang_group/hdacp1/.local/lib/python3.9/site-packages/torch/lib:${LD_LIBRARY_PATH:-}"
  export PYTHONPATH="$ROOT/python"
  if [[ "$dataset" == products ]]; then
    export PRODUCTS_CACHE="$PRODUCTS_CACHE_DEFAULT"
    unset IGB_ROOT IGB_LABEL_FILE IGB_SPLIT_SEED
    export TFS_HS_CACHE_MAX_BYTES=3000000000
  else
    export IGB_ROOT="$IGB_ROOT_DEFAULT" IGB_LABEL_FILE=node_label_19.npy IGB_SPLIT_SEED=20260813
    unset PRODUCTS_CACHE
    export TFS_HS_CACHE_MAX_BYTES=3000000000
  fi

  if [[ "$method" == hybrid ]]; then
    export TFS_RELEASE_PROFILE=v2_3_dataflow
    source "$ROOT/scripts/tfs_standard_env.sh"
    export TFS_RUNTIME_CONTRACT_DIR="$run"
    export TFS_MEMORY_POLICY=localalloc TFS_CPU_NODES=0-3 TFS_MEMORY_NODES=0-3
    export TFS_AMX_PERMISSION_CACHE=1
    export HYBRID_PATH=hybrid HYBRID_AMX_FORWARD=1 HYBRID_AMX_BACKWARD=1
    export HYBRID_PERSISTENT_HS_CACHE=1
    export PYTHONPATH="$ROOT/build/extension:$ROOT/python:$ROOT/csrc"
  else
    export HYBRID_PATH=dgl_stock HYBRID_DGL_VARIANT=stock
    export HYBRID_AMX_FORWARD=0 HYBRID_AMX_BACKWARD=0
    unset HYBRID_PERSISTENT_HS_CACHE HYBRID_STATIC_AGG_CACHE
    unset TFS_RELEASE_PROFILE TFS_RELEASE_CONTRACT_STRICT TFS_RUNTIME_CONTRACT TFS_RUNTIME_CONTRACT_DIR
    unset TFS_EXEC_PLANNER TFS_STATIC_HS TFS_STATIC_AGGREGATE TFS_AGGREGATE_SAVED
    unset TFS_SMALL_SINGLE_SCAN TFS_ACTIVE_ROW TFS_NUMA_PRIVATE TFS_NUMA_REDUCE
    unset TFS_NUMA_FIRST_TOUCH TFS_PULL_ONLY_BACKWARD TFS_SCALE_GRAD_BF16_NATIVE
    unset TFS_HIGHD_RELEASE_MODE TFS_HIGHD_STREAM_V1 TFS_HIGHD_NATIVE_STREAM
    unset TFS_TRANSFORM_HIGHD_STREAM_V1 TFS_TRANSFORM_HIGHD_SINGLE_SCAN
    unset TFS_AGGREGATE_DSLAB_SINGLE_SCAN TFS_HIGHD_BWD_BUDGET_BYTES TFS_HIGHD_BWD_D_TILE
    unset TFS_HIGHD_BWD_ROW_PANEL TFS_TRANSFORM_HIGHD_D_TILE TFS_HIGHD_NATIVE_PANEL
    unset TFS_WORKSPACE_CACHE_MAX_BYTES TFS_HIGHD_PANEL_BUDGET_BYTES TFS_HIGHD_FUSED_DB
    unset TFS_HIGHD_FUSED_TRANSPOSE TFS_HIGHD_FUSED_SCALE_TRANSPOSE TFS_HIGHD_CONTIGUOUS_PANELS TFS_COLIDX
    unset TFS_MAX_LOCAL_DW_BYTES TFS_LOCAL_DW_BUDGET_BYTES TFS_HIGHD_NATIVE_SCALE TFS_HIGHD_STREAM_AUTO
    unset TFS_GLUE_E1_FUSED_DB TFS_GLUE_E2_VEC_STORE TFS_GLUE_E3_EMPTY_DX
    unset TFS_GLUE_E4_FUSED_EPILOGUE TFS_GLUE_E5_VEC_HS TFS_GLUE_E6_LOCAL_ZERO
    unset TFS_GLUE_E6_PARALLEL_REDUCE TFS_GLUE_E6_SERIAL_WT TFS_GLUE_E7_FORWARD_SCHEDULE
    unset TFS_GLUE_E8_RIGHTSIZE_POOL TFS_GLUE_E8_ATOMIC_DONE TFS_GLUE_E8_SPIN
    unset TFS_GLUE_E9_INT32_COLIDX TFS_GLUE_E11_VEC_GRAD_DB TFS_FWD_V2_SINGLE_SCAN
    unset TFS_GLUE_E12_D47_SINGLE_SCAN TFS_GLUE_E13_ACTIVE_ROW TFS_GLUE_E14_ACTIVE_ROW_WIDE TFS_E13_ACTIVE_MAX_DENSITY
    unset TFS_MEMORY_POLICY TFS_CPU_NODES TFS_MEMORY_NODES TFS_LOCALITY_SCHEDULE TFS_HS_REPLICA
    unset TFS_HS_CACHE_MAX_BYTES TFS_PROFILE_NUMA_WORKSPACE TFS_INTERNAL_PROFILE
    unset TFS_HIGHD_NATIVE_SCALE TFS_HIGHD_STREAM_AUTO HYBRID_STATIC_AGG_CACHE
  fi

  export HYBRID_OUTPUT="$run/training_detailed.csv"
  export HYBRID_OP_PROFILE="$run/dgl_ops.jsonl"
  hostname > "$run/hostname.txt"
  lscpu > "$run/lscpu.txt"
  numactl -H > "$run/numa.txt"
  env | sort > "$run/environment_start.txt"
  sha256sum "$test_py" "$ROOT/python/tfs_train/execution_plan.py" "$ROOT/scripts/tfs_standard_env.sh" 2>/dev/null > "$run/source_input_sha256.tsv" || true

  local start_ns end_ns code wall_ms
  start_ns=$(date +%s%N)
  set +e
  numactl --cpunodebind=0-3 --localalloc python -u "$test_py" > "$run/stdout.log" 2> "$run/stderr.log"
  code=$?
  # The caller intentionally runs both methods even if the first method
  # fails, so do not re-enable errexit inside this function before returning
  # the measured exit code.  With ``set -e`` here bash exits the whole array
  # task at the TFS failure and the native-DGL mate is never launched.
  end_ns=$(date +%s%N)
  wall_ms=$(( (end_ns - start_ns) / 1000000 ))
  printf '%s\n' "{\"status\":\"$([[ $code -eq 0 ]] && echo success || echo failed)\",\"profile\":\"${TFS_RELEASE_PROFILE:-native_dgl_stock}\",\"method\":\"$method\",\"dataset\":\"$dataset\",\"threads\":32,\"epochs\":200,\"wall_ms\":$wall_ms,\"exit_code\":$code}" > "$run/status.json"
  return "$code"
}

set +e
run_one hybrid; tfs_code=$?
run_one dgl_stock; dgl_code=$?
set -e
printf '%s\n' "{\"dataset\":\"$dataset\",\"tfs_exit\":$tfs_code,\"dgl_exit\":$dgl_code,\"epochs\":200,\"threads\":32,\"same_node\":true}" > "$RUN_ROOT/${run_name}_pair_status.json"
test "$tfs_code" -eq 0 -a "$dgl_code" -eq 0
